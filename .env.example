# Client-side (safe to ship to the browser — used by src/lib/supabaseClient.ts)
VITE_SUPABASE_URL=https://zniqcegwyaaskldsizdo.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by netlify/functions/admin.ts) — set these in the
# Netlify site's Environment variables UI, NEVER commit real values or
# prefix them with VITE_.
SUPABASE_URL=https://zniqcegwyaaskldsizdo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# Server-side only (used by netlify/functions/website-audit.ts). Sign up at
# https://www.browserless.io for an API key — any region works with any
# account (no per-account assigned region), so BROWSERLESS_BASE_URL is
# optional and only needed to pick a closer region than the default
# https://production-sfo.browserless.io (also available:
# production-lon.browserless.io, production-ams.browserless.io).
BROWSERLESS_API_KEY=
BROWSERLESS_BASE_URL=
# Optional. How many pages/screenshots the crawler renders at once via
# Browserless. Defaults to 1 (safe for trial/free-tier plans, which
# typically cap concurrent sessions low) — a 429 from Browserless's own
# gateway on every request, regardless of target site, means this needs to
# stay at 1 or go lower still. Raise it only once you've confirmed your
# Browserless plan allows more concurrent sessions.
BROWSERLESS_CONCURRENCY=

# Server-side only (used by netlify/functions/lib/tone-analysis.ts).
# Perceived-tone analysis (Creative Audit) and the AI-summarizability note
# (Technical Audit) — the first Claude calls made by this app; every other
# Claude call in this system lives in the separate `audit` app with its own
# key. Same underlying Anthropic account is fine, but this needs its own
# env var set on THIS Netlify site. Both features degrade gracefully (the
# rest of the audit still saves) if this is unset — you'll just see
# "Skipped — ANTHROPIC_API_KEY is not set" in that section of the report.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Server-side only (used by netlify/functions/lib/pagespeed.ts). SEO Audit's
# (Comprehensive tier only) performance/accessibility check. Sign up for a
# free Google Cloud API key with the "PageSpeed Insights API" enabled — no
# billing required for reasonable usage. Unlike the two keys above, this one
# is required for the performance step to run at all (it throws a clear
# error if unset rather than degrading, since the whole point of that step
# is this data).
PAGESPEED_API_KEY=

# Server-side only (used by netlify/functions/lib/seo-studio-handoff.ts).
# Where the sibling `audit` app is deployed, and the shared secret for its
# POST /api/seo-studio/create-report route — called right after an SEO
# Audit crawl saves its Research document(s), to create a draft review
# report a consultant edits/approves there before anything reaches the
# client. SEO_STUDIO_HANDOFF_SECRET must match the identically-named env
# var set on the `audit` app's own deployment. Generate with, e.g.,
# `openssl rand -hex 32` — anyone with this value can create real reports
# (and trigger real Claude API calls) on that deployment, so treat it like
# a password.
AUDIT_APP_BASE_URL=
SEO_STUDIO_HANDOFF_SECRET=
